 
{
  "buildCommand": "cd ui && rm -rf contracts-src && cp -r ../contracts/src contracts-src && npm run generate",
  "installCommand": "npm install --prefix ui",
  "outputDirectory": "ui/.output/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
 