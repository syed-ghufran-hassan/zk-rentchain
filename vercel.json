{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ui && npm install && npm run generate",
  "outputDirectory": "ui/.output/public",
  "framework": "nuxtjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}